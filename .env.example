# Mosaic Claude SDK plugin — environment template
# Copy to `.env` and fill in values. .env is gitignored.

# Live Mosaic MCP server endpoint (provided by Strategy).
MOSAIC_MCP_URL=

# Anthropic API key for the example agents.
ANTHROPIC_API_KEY=

# Integration tests only — known-good project / model in your environment.
MOSAIC_TEST_PROJECT=world demos
MOSAIC_TEST_MODEL=customer health

# Integration tests only — bearer token / PAT for the test user. Optional;
# omit if your MCP endpoint embeds auth in the URL.
MOSAIC_MCP_TOKEN=
